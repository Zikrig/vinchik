BOT_TOKEN=
POSTGRES_USER=vinchik
POSTGRES_PASSWORD=vinchik
POSTGRES_DB=vinchik
# Не используйте $ в паролях/.env — Docker Compose воспринимает $VAR как подстановку.
DATABASE_URL=postgresql+asyncpg://vinchik:vinchik@db:5432/vinchik
REDIS_URL=redis://redis:6379/0
ADMIN_IDS=123456789
ADMIN_WEB_PASSWORD=change-me
MANAGER_CONTACT=@manager
PAYMENT_CARD=
PAYMENT_CHECK_TIME=в течение 24 часов
BOT_USERNAME=your_bot
WEB_SECRET_KEY=change-me-to-random-string
WEB_HOST=0.0.0.0
WEB_PORT=8080

# false = long polling; true = webhook (нужен HTTPS-домен)
USE_WEBHOOK=false
WEBHOOK_BASE_URL=https://your.domain
WEBHOOK_PATH=/webhook/bot
WEBHOOK_SECRET=change-me-webhook-secret
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8081
