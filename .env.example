BOT_TOKEN=
# Без символа $ в значениях — Docker Compose иначе портит пароль.
POSTGRES_USER=vinchik
POSTGRES_PASSWORD=vinchik
POSTGRES_DB=vinchik
REDIS_URL=redis://redis:6379/0
ADMIN_IDS=123456789
ADMIN_WEB_PASSWORD=change-me
MANAGER_CONTACT=@manager
PAYMENT_CARD=
PAYMENT_CHECK_TIME=в течение 24 часов
BOT_USERNAME=your_bot
WEB_SECRET_KEY=change-me-to-random-string
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Префикс за nginx (пусто локально). На krigz.com:
WEB_ROOT_PATH=/vinchik

# false = long polling; true = webhook (нужен HTTPS-домен)
USE_WEBHOOK=false
WEBHOOK_BASE_URL=https://krigz.com
# Путь, который видит Telegram (= location в nginx). Compose форсит порт 8081 внутри.
WEBHOOK_PATH=/vinchik/webhook
WEBHOOK_SECRET=change-me-webhook-secret
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8081
